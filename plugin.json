  "keywords": [
    "multi-agent",
    "mcp",
    "rag",
    "graphify",
    "sop",
    "metagpt",
    "debate",
    "stride",
    "coordination",
    "aider"
  ],
  "mcpServers": {
    "gossip": {
      "command": "/home/user/Projects/gossip/bin/gossip-mcp",
      "args": [
        "serve",
        "--dir",
        "/home/user/Projects/gossip/.local/gossip"
      ],
      "cwd": "/home/user/Projects/gossip",
      "env": {
        "GOSSIP_DIR": "/home/user/Projects/gossip/.local/gossip"
      }
    }
  },
  "skills": [
    "skills/gossip"
  ]
