        "description": "List of capability tags",
        "type": "array"
      },
      "category": {
        "description": "Category: 'management', 'engineering', 'specialist', 'assurance'",
        "type": "string"
      },
      "description": {
        "description": "Detailed description of role responsibilities",
        "type": "string"
      },
      "directives": {
        "description": "List of behavioral rules/directives",
        "type": "array"
      },
      "id": {
        "description": "Unique role identifier (e.g. 'devops_engineer', 'quantum_expert')",
        "type": "string"
      },
      "recommended_tools": {
        "description": "List of recommended MCP tools",
        "type": "array"
      },
      "system_prompt": {
        "description": "System prompt and operational persona",
        "type": "string"
      },
