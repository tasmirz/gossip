{
  "name": "gossip_register_custom_role",
  "description": "Dynamically define and register a new custom agent role at runtime (stored in JSON)",
  "parameters": {
    "properties": {
      "caller_role": {
        "description": "Role of the agent registering the custom role (e.g. 'orchestrator')",
        "type": "string"
      },
