{
  "name": "gossip_setup_tunnel",
  "description": "Configure, generate, or manage FRP reverse-proxy tunnels for WAN/LAN remote access with mandatory HTTP Basic Auth protection",
  "parameters": {
    "properties": {
      "action": {
        "description": "Action: 'activate' (default), 'generate', or 'deactivate'",
        "type": "string"
      },
      "auth_token": {
        "description": "FRP server authentication token",
        "type": "string"
      },
      "custom_domain": {
        "description": "Custom domain or subdomain for HTTP proxying",
        "type": "string"
      },
      "format": {
        "description": "Format for 'generate': 'toml' (default), 'ini', 'server_toml', 'server_ini'",
        "type": "string"
      },
      "http_pass": {
        "description": "Mandatory HTTP Basic Auth password (min 6 characters)",
        "type": "string"
      },
      "http_user": {
        "description": "Mandatory HTTP Basic Auth username",
        "type": "string"
      },
      "server_addr": {
        "description": "FRP server hostname or IP",
        "type": "string"
      },
      "server_port": {
        "description": "FRP server bind port (default: 7000)",
        "type": "number"
      }
    },
    "required": [
      "server_addr"
    ],
    "type": "object"
  },
