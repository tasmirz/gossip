{
  "name": "gossip_handshake",
  "description": "Introduce and register a remote peer agent across the FRP tunnel or LAN into the local mesh, enabling multi-worktree collaboration and remote queries",
  "parameters": {
    "properties": {
      "peer_agent_id": {
        "description": "Remote peer agent ID",
        "type": "string"
      },
      "peer_capabilities": {
        "description": "Capabilities offered by remote peer",
        "type": "array"
      },
      "peer_endpoint": {
        "description": "Remote endpoint URL (e.g. 'http://peer.remote:8080' or 'frp://tunnel:7000')",
        "type": "string"
      },
      "peer_role": {
        "description": "Remote peer role",
        "type": "string"
      },
      "peer_worktree": {
        "description": "Remote peer's worktree path or repository name",
        "type": "string"
      }
    },
    "required": [
      "peer_agent_id",
      "peer_role",
      "peer_endpoint"
    ],
    "type": "object"
  },
