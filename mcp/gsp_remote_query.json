{
  "name": "gsp_remote_query",
  "description": "Query a remote Gossip mesh node across the FRP tunnel or LAN when worktrees differ (e.g. separate repos or branches), querying remote graph, tasks, repomap, or status",
  "parameters": {
    "properties": {
      "auth_pass": {
        "description": "HTTP Basic Auth password for remote node",
        "type": "string"
      },
      "auth_user": {
        "description": "HTTP Basic Auth username for remote node",
        "type": "string"
      },
      "query_text": {
        "description": "Query text or symbol label (for 'graph')",
        "type": "string"
      },
      "query_type": {
        "description": "Type of query: 'graph', 'tasks', 'status', 'repomap'",
        "type": "string"
      },
      "remote_endpoint": {
        "description": "Remote node URL (e.g. 'http://mesh.remote:8080')",
        "type": "string"
      }
    },
    "required": [
      "remote_endpoint",
      "query_type"
    ],
    "type": "object"
  },
  "inputSchema": {
    "properties": {
      "auth_pass": {
        "description": "HTTP Basic Auth password for remote node",
        "type": "string"
      },
      "auth_user": {
        "description": "HTTP Basic Auth username for remote node",
        "type": "string"
      },
      "query_text": {
        "description": "Query text or symbol label (for 'graph')",
        "type": "string"
      },
      "query_type": {
        "description": "Type of query: 'graph', 'tasks', 'status', 'repomap'",
        "type": "string"
      },
      "remote_endpoint": {
        "description": "Remote node URL (e.g. 'http://mesh.remote:8080')",
        "type": "string"
      }
    },
    "required": [
      "remote_endpoint",
      "query_type"
    ],
    "type": "object"
  }
}