{
  "mcpServers": {
    "gossip": {
      "command": "${workspaceFolder}/bin/gossip-mcp",
      "args": [
        "coord-mcp",
        "--credential-file",
        "${userHome}/.config/gossip/credentials/project.json"
      ]
    },
    "gossip-project-bootstrap": {
      "command": "${workspaceFolder}/bin/gossip-mcp",
      "args": [
        "coord-mcp-bootstrap",
        "--bootstrap-api-key-file",
        "${userHome}/.config/gossip/bootstrap.key",
        "--credential-dir",
        "${userHome}/.config/gossip/credentials"
      ]
    }
  }
}
