{
  "mcpServers": {
    "gossip": {
      "command": "/home/user/Projects/gossip/bin/gossip-mcp",
      "args": [
        "coord-mcp",
        "--credential-file",
        "/private/path/to/project-credential.json"
      ],
      "cwd": "/home/user/Projects/gossip",
      "env": {}
    },
    "gossip-project-bootstrap": {
      "command": "/home/user/Projects/gossip/bin/gossip-mcp",
      "args": [
        "coord-mcp-bootstrap",
        "--bootstrap-api-key-file",
        "/private/path/gossip/bootstrap.key",
        "--credential-dir",
        "/private/path/gossip/credentials"
      ],
      "cwd": "/home/user/Projects/gossip"
    }
  }
}
