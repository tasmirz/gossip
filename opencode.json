{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gossip": {
      "type": "local",
      "command": [
        "/home/user/Projects/gossip/bin/gossip-mcp",
        "serve",
        "--dir",
        "/home/user/Projects/gossip/.local/gossip"
      ],
      "enabled": true,
      "environment": {
        "GOSSIP_DIR": "/home/user/Projects/gossip/.local/gossip"
      }
    }
  }
}
