{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gossip": {
      "type": "local",
      "command": [
        "/absolute/path/to/gossip",
        "serve",
        "--dir",
        "/private/path/gossip"
      ],
      "enabled": true,
      "environment": {
        "GOSSIP_DIR": "/private/path/gossip"
      }
    }
  }
}
