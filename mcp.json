{
  "mcpServers": {
    "gossip": {
      "command": "./bin/gossip-mcp",
      "args": [
        "coord-mcp",
        "--db",
        "/private/path/gossip/coord.db",
        "--credential-file",
        "./.gossip/credentials/project.json"
      ]
    },
    "gossip-project-bootstrap": {
      "command": "./bin/gossip-mcp",
      "args": [
        "coord-mcp-bootstrap",
        "--db",
        "/private/path/gossip/coord.db",
        "--bootstrap-api-key-file",
        "/private/path/gossip/bootstrap.key",
        "--credential-dir",
        "/private/path/gossip/credentials"
      ]
    }
  }
}
